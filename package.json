{
  "name": "termdeck",
  "private": true,
  "version": "0.1.4",
  "description": "Portable multi-session terminal for the Claude Code, Codex, Grok and Antigravity CLIs on Windows",
  "license": "MIT",
  "repository": "github:aivrar/TermDeck",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "app:debug": "tauri build --debug --no-bundle",
    "app:release": "tauri build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
